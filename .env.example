# Public analytics / Search Console — leave empty until Rubio provides real IDs.
# Do not invent placeholder values. Site remains fully functional when unset.

# Google Tag Manager container (orchestration layer). Required for runtime tagging.
# Example format only: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# GA4 Measurement ID is configured inside the GTM container — not an application env var.
# Do not set a parallel NEXT_PUBLIC_GA4_MEASUREMENT_ID on the website.

# Optional: Google Search Console HTML meta token for URL-prefix verification only.
# Preferred Domain Property workflow uses DNS TXT (manual) — not this env var.
# Leave empty unless using URL-prefix HTML verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
